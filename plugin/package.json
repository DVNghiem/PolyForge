{
  "name": "@dv.nghiem/polyforge",
  "version": "0.1.0",
  "description": "PolyForge plugin — backend engineering command center for polyglot developers on OpenClaw",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "polyforge": "bin/polyforge.mjs"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "openclaw": {
    "extensions": [
      "dist/index.js"
    ]
  },
  "files": [
    "dist",
    "bin",
    "agents",
    "skills",
    "workflows",
    "openclaw.plugin.json"
  ],
  "keywords": [
    "openclaw",
    "plugin",
    "polyglot",
    "backend",
    "orchestration"
  ],
  "license": "MIT",
  "dependencies": {
    "@sinclair/typebox": "^0.34.0",
    "json5": "^2.2.3"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
