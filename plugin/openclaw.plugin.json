{
  "id": "polyforge",
  "name": "PolyForge",
  "description": "Backend engineering command center — 8 agents, category-based model routing, todo enforcer, autorun loop, agent setup CLI, and custom tools for polyglot developers",
  "version": "0.1.0",
  "skills": [
    "skills"
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "max_auto_iterations": {
        "type": "integer",
        "minimum": 0,
        "maximum": 500,
        "default": 50,
        "description": "Maximum autorun loop iterations per session (hard cap: 500)"
      },
      "todo_enforcer_enabled": {
        "type": "boolean",
        "default": true,
        "description": "Enable todo continuation injection on agent bootstrap"
      },
      "todo_enforcer_cooldown_ms": {
        "type": "integer",
        "minimum": 1,
        "default": 2000,
        "description": "Cooldown between todo enforcer injections (ms)"
      },
      "todo_enforcer_max_failures": {
        "type": "integer",
        "minimum": 1,
        "default": 5,
        "description": "Max consecutive failures before disabling todo enforcer"
      },
      "comment_checker_enabled": {
        "type": "boolean",
        "default": true,
        "description": "Enable AI slop comment detection on tool results"
      },
      "checkpoint_dir": {
        "type": "string",
        "default": "workspace/checkpoints",
        "description": "Directory for execution checkpoints"
      },
      "model_routing": {
        "type": "object",
        "description": "Custom category→model mappings. Override default model selection per category.",
        "additionalProperties": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string",
              "description": "Model identifier"
            },
            "alternatives": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Fallback models"
            }
          },
          "required": [
            "model"
          ]
        }
      },
      "preferred_language": {
        "type": "string",
        "enum": ["python", "rust", "typescript", "mixed"],
        "default": "mixed",
        "description": "Primary language for this project. Guides lang-detector and skill injection."
      },
      "research_depth": {
        "type": "string",
        "enum": ["shallow", "standard", "deep"],
        "default": "standard",
        "description": "Default depth for pf_research tool"
      },
      "team_agent_ids": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": [],
        "description": "OpenCode agent IDs that represent team members Atlas can delegate to"
      },
      "workflow_phase_enforcement": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean", "default": true },
          "default_approval_level": { "type": "string", "enum": ["low", "medium", "high"], "default": "medium" },
          "per_workflow_overrides": {
            "type": "object",
            "additionalProperties": { "type": "string", "enum": ["low", "medium", "high"] }
          }
        }
      },
      "acp_spawning": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean", "default": true },
          "allow_detached_by_default": { "type": "boolean", "default": false },
          "max_concurrent_detached": { "type": "integer", "default": 5 },
          "detached_timeout_ms": { "type": "integer", "default": 3600000 }
        }
      },
      "intelligent_features": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "adaptive_learning": {
            "type": "object",
            "properties": {
              "enabled": { "type": "boolean", "default": true },
              "min_samples_for_auto_approve": { "type": "integer", "default": 5 },
              "auto_approve_threshold": { "type": "number", "default": 0.9 }
            }
          },
          "proactive_suggestions": {
            "type": "object",
            "properties": {
              "enabled": { "type": "boolean", "default": true },
              "suggestion_interval_ms": { "type": "integer", "default": 30000 }
            }
          },
          "quality_gates": {
            "type": "object",
            "properties": {
              "enabled": { "type": "boolean", "default": true },
              "enforcement_level": { "type": "string", "enum": ["strict", "moderate", "lenient"], "default": "moderate" },
              "default_threshold": { "type": "number", "default": 0.75 }
            }
          }
        }
      }
    }
  },
  "uiHints": {
    "max_auto_iterations": {
      "label": "Autorun Max Iterations",
      "description": "Maximum iterations before auto-stopping the autorun loop",
      "group": "Autorun"
    },
    "todo_enforcer_enabled": {
      "label": "Todo Enforcer",
      "description": "Inject TODO continuation prompts on agent bootstrap",
      "group": "Todo Enforcer"
    },
    "todo_enforcer_cooldown_ms": {
      "label": "Cooldown (ms)",
      "description": "Minimum time between TODO enforcer injections",
      "group": "Todo Enforcer"
    },
    "todo_enforcer_max_failures": {
      "label": "Max Failures",
      "description": "Consecutive failures before auto-disabling enforcer",
      "group": "Todo Enforcer"
    },
    "comment_checker_enabled": {
      "label": "Comment Checker",
      "description": "Detect and flag AI-generated slop comments",
      "group": "Quality"
    },
    "checkpoint_dir": {
      "label": "Checkpoints Directory",
      "description": "Path for execution checkpoint files",
      "group": "Storage"
    },
    "model_routing": {
      "label": "Model Routing",
      "description": "Custom category→model mappings for task delegation",
      "group": "Model Routing"
    },
    "preferred_language": {
      "label": "Preferred Language",
      "description": "Primary language for this project (python, rust, typescript, mixed)",
      "group": "Language"
    },
    "research_depth": {
      "label": "Research Depth",
      "description": "Default depth for technology research (shallow, standard, deep)",
      "group": "Research"
    },
    "team_agent_ids": {
      "label": "Team Agent IDs",
      "description": "OpenCode agent IDs for team members Atlas can delegate to",
      "group": "Team"
    }
  }
}
